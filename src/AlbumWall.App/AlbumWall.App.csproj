<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The target follows what is being built FOR, not where. A Windows build
         targets the Windows SDK so that Smtc.cs can reach the System Media
         Transport Controls (media keys, headset buttons, the card in the volume
         flyout); that target also defines WINDOWS, which is what Smtc.cs is
         wrapped in. Everything else is plain net10.0, and Linux gets its media
         keys from Mpris.cs.

         This used to be chosen by the BUILD HOST, which quietly cost the family
         its one-box release: publishing linux-x64 from Windows picked the
         Windows target, and Windows could not be published from Linux at all.
         Keyed on the RuntimeIdentifier instead, any machine can publish every
         platform. With no RID given — a plain `dotnet run` — the host decides,
         exactly as before, so day-to-day development is unchanged.

         EnableWindowsTargeting is what lets a non-Windows host build the
         Windows target: the SDK reference pack arrives from NuGet, and only
         when a win-* publish actually asks for it.

         Still deliberately not multi-targeting, which would build both targets
         on every machine on every build. The output folder differs by target:
         bin/<cfg>/net10.0-windows10.0.19041.0/ versus bin/<cfg>/net10.0/. -->
    <ForWindows Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier.StartsWith('win'))</ForWindows>
    <ForWindows Condition="'$(RuntimeIdentifier)' == ''">$([MSBuild]::IsOSPlatform('Windows'))</ForWindows>
    <TargetFramework Condition="'$(ForWindows)' == 'True'">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(ForWindows)' != 'True'">net10.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- The executable is the product's name, as everywhere in the family
         (ShackPower.exe, not ShackPower.App.exe). The PROJECT keeps its name and
         its namespace; only what lands on disk changes. Decided before
         InstallService exists, because that is where a file name gets baked
         into shortcuts and registry entries. -->
    <AssemblyName>AlbumWall</AssemblyName>
    <Version>0.1.0</Version>
    <!-- A release is a TRUE single file, the family's standard (see Shack Power):
         the in-app updater replaces only the exe, so everything native — Skia,
         HarfBuzz, and our own libmpv — MUST be inside it, not shipped loose
         beside it. Applies on publish with a RID; ignored by build and run. -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- PublishSelfContained, NOT SelfContained. The plain property applies to
         ordinary builds too: the SDK infers a runtime, moves everyday output
         into bin/<cfg>/<tfm>/<rid>/, and copies the whole .NET runtime into it
         on every build. This one acts only during publish. -->
    <PublishSelfContained>true</PublishSelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The icon compiled into the exe: what Explorer, the taskbar and the Start
         Menu shortcut show. The source is Assets/icon.svg; tools/make_icon.py
         renders app.ico and app-icon.png from it, and the outputs are committed
         so nobody building this needs ImageMagick. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <!-- Already present transitively via Avalonia.FreeDesktop; referenced
         explicitly because MPRIS uses it directly. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- And the same icon as a resource, for the windows' own title bars. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- The third-party notices, from the root of the repository where people look
         for such a file, carried INSIDE the exe so that they travel with it: the
         About tab's "What's inside" shows this copy. One file, two homes. -->
    <AvaloniaResource Include="..\..\THIRD-PARTY-NOTICES.md" Link="Assets\THIRD-PARTY-NOTICES.md" />
    <!-- And the license TEXTS, verbatim from each upstream (tools/fetch-licenses.py), plus our
         own. "What's inside" lists them under the notices, each behind its own fold. -->
    <AvaloniaResource Include="..\..\licenses\*" Exclude="..\..\licenses\README.md" Link="Assets\licenses\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\..\LICENSE" Link="Assets\licenses\AlbumWall-LICENSE.GPLv3.txt" />
    <!-- Also embedded plainly: the Linux installer writes this icon into the XDG
         icon theme for the .desktop entry, and the install switch runs before
         Avalonia is initialized, so the Avalonia asset loader is not available
         to read it. Generated from icon.svg by tools/make_icon.py. -->
    <EmbeddedResource Include="Assets\app-icon.png" LogicalName="app-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AlbumWall.Domain\AlbumWall.Domain.csproj" />
    <ProjectReference Include="..\AlbumWall.Playback\AlbumWall.Playback.csproj" />
  </ItemGroup>

  <!-- The app's own libmpv, per platform: fetched on Windows
       (scripts/get-libmpv.ps1), built on Linux (scripts/build-libmpv/). Never
       committed either way — native/ is git-ignored.

       The folder follows what is being built FOR, same rule as the target
       framework above, so a win-x64 publish made on Fedora picks up the Windows
       DLL and not this machine's .so. With no RID, the host decides.

       The whole group is conditional on the folder existing: a development
       checkout without it builds fine and uses the distribution's libmpv. -->
  <PropertyGroup>
    <NativeRid>$(RuntimeIdentifier)</NativeRid>
    <HostArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</HostArch>
    <NativeRid Condition="'$(NativeRid)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-$(HostArch)</NativeRid>
    <NativeRid Condition="'$(NativeRid)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-$(HostArch)</NativeRid>
    <NativeDir>$(MSBuildProjectDirectory)/../../native/$(NativeRid)</NativeDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(NativeRid)' != '' and Exists('$(NativeDir)')">
    <None Include="$(NativeDir)/*.dll;$(NativeDir)/*.so*" Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
