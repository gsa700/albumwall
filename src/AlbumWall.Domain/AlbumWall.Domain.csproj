<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Native AOT (docs/roadmap.md, the road to it): warn at every build about
         code a trimmed or compiled build cannot run. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Spindle.Core, the helpers the apps share (the submodule at spindle/):
         VersionOrder, ReleaseFeed, LogFile, Diagnostics. -->
    <ProjectReference Include="..\..\spindle\src\Spindle.Core\Spindle.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Spindle" />
  </ItemGroup>

</Project>
