<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- One target per machine, chosen by where it is being BUILT. On Windows
         the app targets the Windows SDK so that Smtc.cs can reach the System
         Media Transport Controls (media keys, headset buttons, the card in the
         volume flyout); that target also defines WINDOWS, which is what Smtc.cs
         is wrapped in. Everywhere else it is plain net10.0, as it always was,
         and Linux gets its media keys from Mpris.cs.

         Deliberately not multi-targeting: that would build both on every
         machine, and the Windows one cannot be built on Fedora without the
         Windows targeting pack being pulled in for no reason.

         It does mean the output folder differs by platform:
         bin/Debug/net10.0-windows10.0.19041.0/ here, bin/Debug/net10.0/ there. -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <!-- Already present transitively via Avalonia.FreeDesktop; referenced
         explicitly because MPRIS uses it directly. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AlbumWall.Domain\AlbumWall.Domain.csproj" />
    <ProjectReference Include="..\AlbumWall.Playback\AlbumWall.Playback.csproj" />
  </ItemGroup>

  <!-- libmpv on Windows, fetched by scripts/get-libmpv.ps1 rather than
       committed: it is a large binary from another GPL project. Absent on
       Linux, where libmpv comes from the distribution, so the whole group is
       conditional on the folder existing. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/../../native/win-x64')">
    <None Include="../../native/win-x64/*.dll" Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
