# Normalise line endings in the repo. The Avalonia project template emits
# CRLF for some files; without this a Windows contributor's first commit
# would look like a whole-file rewrite.
* text=auto eol=lf
*.png binary
*.jpg binary
*.webp binary

# Other people's license texts, fetched verbatim (tools/fetch-licenses.py) and listed
# with their SHA-256 in licenses/README.md. Not ours to normalise: stored as they came.
licenses/** -text
