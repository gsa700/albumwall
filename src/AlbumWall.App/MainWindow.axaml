<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:app="clr-namespace:AlbumWall.App"
        x:Class="AlbumWall.App.MainWindow"
        Title="AlbumWall"
        Icon="/Assets/app.ico"
        Width="1444" Height="1080"
        WindowStartupLocation="Manual"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        RequestedThemeVariant="Dark"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None">

    <Window.Resources>

        <!-- Fluent draws the slider thumb from THESE keys, not from Thumb's own
             Background, which is why setting that left the thumb system-blue on
             an otherwise entirely warm window. -->
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#F3EEE6"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#C9BFB2"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#E8E0D4"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#F3EEE6"/>
        <SolidColorBrush x:Key="SliderTrackFill" Color="#4A423B"/>
        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#564D45"/>
        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#564D45"/>

        <!-- One row of covers. The row is exactly as wide as its albums, so the
             arrow offsets computed for the panel below it stay correct. -->
        <DataTemplate x:Key="AlbumRowTemplate" DataType="app:AlbumRow">
            <ItemsControl ItemsSource="{Binding Albums}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="15"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="app:AlbumVm">
                        <Button Classes="tile" Command="{Binding OpenCommand}"
                                AutomationProperties.Name="{Binding Spoken}">
                            <StackPanel Spacing="5" Width="{DynamicResource CoverPx}">
                                <Panel Width="{DynamicResource CoverPx}"
                                       Height="{DynamicResource CoverPx}">
                                    <Border Classes="ground" Background="{Binding Placeholder}" CornerRadius="2"
                                            Opacity="{Binding GroundOpacity}"/>
                                    <!-- The WHOLE cover, never cropped and never
                                         enlarged past FaceMax: a small or oblong
                                         one sits centered on the ground above.
                                         A BACK is oblong by nature (a tray card
                                         scan, spines included) so it letterboxes
                                         here by the same rule.

                                         RenderTransform is the flip: the view
                                         model owns a Rotate3DTransform and
                                         animates its AngleY. Bound as a whole
                                         object, never as a property INSIDE a
                                         transform: transforms are not in the
                                         visual tree and x:Name on one does not
                                         even compile. Null until the album is
                                         first opened, so an untouched tile
                                         carries no transform at all. -->
                                    <Image Classes="cover" Source="{Binding Face}"
                                           Opacity="{Binding CoverOpacity}"
                                           Stretch="{Binding FaceStretch}"
                                           RenderTransform="{Binding Turn}"
                                           RenderTransformOrigin="50%,50%"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image.MaxWidth>
                                            <MultiBinding Converter="{x:Static app:AlbumVm+FitConverter.Instance}">
                                                <Binding Path="FaceMax"/>
                                                <Binding Path="$parent[Panel].Bounds.Width"/>
                                            </MultiBinding>
                                        </Image.MaxWidth>
                                        <Image.MaxHeight>
                                            <MultiBinding Converter="{x:Static app:AlbumVm+FitConverter.Instance}">
                                                <Binding Path="FaceMax"/>
                                                <Binding Path="$parent[Panel].Bounds.Width"/>
                                            </MultiBinding>
                                        </Image.MaxHeight>
                                    </Image>
                                    <!-- No art at all: the tile is its own sleeve. -->
                                    <StackPanel IsVisible="{Binding HasNoArt}" Margin="14,0,14,14"
                                                VerticalAlignment="Bottom" Spacing="3">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold"
                                                   Foreground="#F2FFFFFF" TextWrapping="Wrap" MaxLines="4"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Artist}" FontSize="11"
                                                   Foreground="#B3FFFFFF" TextWrapping="Wrap" MaxLines="2"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <!-- Selection ring, drawn over the art rather
                                         than around it, so turning it on does not
                                         change the tile's size or the grid. -->
                                    <Border CornerRadius="2" BorderThickness="3"
                                            BorderBrush="{Binding RingBrush}"
                                            IsVisible="{Binding IsSelected}"/>
                                </Panel>
                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                <TextBlock Text="{Binding Artist}" Classes="dim" FontSize="10"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- The open album. Full wall width, colored by its own artwork. -->
        <DataTemplate x:Key="PanelRowTemplate" DataType="app:PanelRow">
            <!-- ClipToBounds is load-bearing, not tidiness. The unfold animates
                 this element's HEIGHT, and without clipping the panel's contents
                 keep painting over the rows below while the height collapses, so
                 a roll-up looks like nothing happening. -->
            <Panel ClipToBounds="True">
                <!-- The arrow points at the cover that was clicked. It is part of
                     the panel, not the row above, so it can never be clipped by
                     the row's bounds. -->
                <Path Data="M 0 11 L 11 0 L 22 11 Z"
                      Fill="{Binding Palette.Panel}"
                      HorizontalAlignment="Left" VerticalAlignment="Top"
                      Margin="{Binding ArrowMargin}"/>

                <!-- Fades out at its foot rather than ending on an edge. The
                     extra bottom padding keeps the track list clear of the part
                     that has gone translucent. -->
                <Border Background="{Binding Palette.PanelFade}"
                        CornerRadius="6,6,0,0"
                        Margin="0,10,0,0" Padding="22,22,22,54">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">

                        <DockPanel Grid.Column="0">
                            <StackPanel DockPanel.Dock="Top" Spacing="3">
                                <TextBlock Text="{Binding Album.Title}" FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="{Binding Palette.Text}"/>
                                <TextBlock Text="{Binding Album.Artist}" FontSize="14"
                                           Foreground="{Binding Palette.TextDim}"/>
                                <TextBlock Text="{Binding HeaderLine}" FontSize="11"
                                           Margin="0,4,0,0"
                                           Foreground="{Binding Palette.TextDim}"/>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                        Spacing="9" Margin="0,14,0,0">
                                <Button Classes="panel" Content="Shuffle"
                                        Command="{Binding ShuffleCommand}"
                                        IsEnabled="{Binding CanPlay}"
                                        ToolTip.Tip="Shuffle this album"/>
                                <Button Classes="panel" Content="Edit tags" IsEnabled="False"
                                        ToolTip.Tip="Tag editing is not built yet"/>
                            </StackPanel>

                            <!-- NO internal scroll region. An album panel sizes to
                                 its own track list and the wall scrolls, because
                                 a scrollable area inside an already-scrolling page
                                 means two scrollbars competing for one wheel. Even
                                 the 46-track box set is only about 26 rows per
                                 column, which the wall carries without complaint. -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="26" Margin="0,16,0,0">
                                <ItemsControl Grid.Column="0" ItemsSource="{Binding LeftColumn}"
                                              ItemTemplate="{StaticResource TrackLineTemplate}"/>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding RightColumn}"
                                              ItemTemplate="{StaticResource TrackLineTemplate}"/>
                            </Grid>
                        </DockPanel>

                        <!-- THE SLEEVE IS THE PLAY BUTTON.
                             Opening an album used to end in a choice: hit Play, or
                             click track one, which do the same thing. Two targets
                             for one intent is a decision where the gesture wants
                             none. The art is the biggest, most obvious thing in
                             the panel and it is what you just picked up, so it is
                             what you press — and it is a far better target for a
                             trackpad or a finger than a text button.

                             The overlay is TRANSLUCENT and only appears under the
                             pointer: his condition, and the right one. The sleeve
                             is the reason this app exists; chrome does not get to
                             cover it up. -->
                        <Button Grid.Column="1" Classes="coverplay"
                                Command="{Binding PlayCommand}"
                                IsEnabled="{Binding CanPlay}"
                                VerticalAlignment="Top">
                            <!-- No tooltip. The glyph that fades in under the
                                 pointer already says "play", and a label arriving
                                 beside it to say so again is the same instruction
                                 twice. -->
                            <Border Width="260" Height="260" CornerRadius="3"
                                    ClipToBounds="True" Background="Transparent">
                                <Panel>
                                    <Border Classes="ground" Background="{Binding Album.Placeholder}"
                                            Opacity="{Binding Album.GroundOpacity}"/>
                                    <Image Source="{Binding Album.Cover}"
                                           Stretch="{Binding Album.CoverStretch}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image.MaxWidth>
                                            <MultiBinding Converter="{x:Static app:AlbumVm+FitConverter.Instance}">
                                                <Binding Path="Album.CoverMax"/>
                                                <Binding Path="$parent[Panel].Bounds.Width"/>
                                            </MultiBinding>
                                        </Image.MaxWidth>
                                        <Image.MaxHeight>
                                            <MultiBinding Converter="{x:Static app:AlbumVm+FitConverter.Instance}">
                                                <Binding Path="Album.CoverMax"/>
                                                <Binding Path="$parent[Panel].Bounds.Width"/>
                                            </MultiBinding>
                                        </Image.MaxHeight>
                                    </Image>
                                    <StackPanel IsVisible="{Binding Album.HasNoArt}" Margin="20,0,20,20"
                                                VerticalAlignment="Bottom" Spacing="4">
                                        <TextBlock Text="{Binding Album.Title}" FontSize="19" FontWeight="Bold"
                                                   Foreground="#F2FFFFFF" TextWrapping="Wrap" MaxLines="4"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Album.Artist}" FontSize="13"
                                                   Foreground="#B3FFFFFF" TextWrapping="Wrap" MaxLines="2"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Panel x:Name="PlayOverlay">
                                        <Border Background="#2E000000"/>
                                        <Ellipse Width="88" Height="88" Fill="#59000000"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                                        <Path Data="M 0 0 L 27 16 L 0 32 Z" Fill="#E8FFFFFF"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="7,0,0,0"/>
                                    </Panel>
                                </Panel>
                            </Border>
                        </Button>
                    </Grid>
                </Border>
            </Panel>
        </DataTemplate>

        <!-- One line of the track list: a disc header or a track. -->
        <DataTemplate x:Key="TrackLineTemplate" DataType="app:TrackLine">
            <Panel>
                <TextBlock Text="{Binding Text}" IsVisible="{Binding IsHeader}"
                           FontSize="11" FontWeight="Bold" Margin="0,14,0,5"
                           Foreground="{Binding $parent[ItemsControl].((app:PanelRow)DataContext).Palette.Accent}"/>
                <Button Classes="track" Classes.playing="{Binding IsPlaying}"
                        IsVisible="{Binding !IsHeader}"
                        Command="{Binding PlayCommand}">
                <Grid ColumnDefinitions="30,*,Auto" Height="28">
                    <TextBlock Grid.Column="0" Text="{Binding Number}" FontSize="12"
                               IsVisible="{Binding NotPlaying}"
                               VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,10,0"
                               Foreground="{Binding $parent[ItemsControl].((app:PanelRow)DataContext).Palette.TextDim}"/>

                    <!-- The playing track shows a marker in place of its number,
                         so the list does not change width as playback moves. The
                         pulse is slow on purpose: it should read as "this one is
                         live", not demand attention. -->
                    <Path Grid.Column="0" Classes="pulse" Data="M 0 0 L 8 5 L 0 10 Z"
                          IsVisible="{Binding IsPlaying}"
                          Fill="{Binding $parent[ItemsControl].((app:PanelRow)DataContext).Palette.Text}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/>

                    <!-- Two blocks rather than a converter: the "playing" color
                         is the PANEL's accent, which differs per album, so there
                         is no single brush a converter could return. -->
                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="14"
                               IsVisible="{Binding !IsPlaying}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{Binding $parent[ItemsControl].((app:PanelRow)DataContext).Palette.Text}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="14"
                               IsVisible="{Binding IsPlaying}" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{Binding $parent[ItemsControl].((app:PanelRow)DataContext).Palette.Text}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Duration}" FontSize="12"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{Binding $parent[ItemsControl].((app:PanelRow)DataContext).Palette.TextDim}"/>
                </Grid>
                </Button>
            </Panel>
        </DataTemplate>

        <!-- The single source of truth for tile geometry. Updating this at
             runtime re-sizes every realized tile without touching bindings. -->
        <sys:Double x:Key="CoverPx">185</sys:Double>
    </Window.Resources>

    <Window.Styles>
        <!-- Warm dark ground so the covers are the brightest thing on screen.
             Deliberately unlike the amber station-tools house style: a wall of
             album art wants different chrome than an instrument panel. -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#F3EEE6"/>
        </Style>
        <!-- Art arrives asynchronously, so without this a cover pops into place
             the instant it decodes. A short fade makes loading read as the wall
             filling in rather than as flicker. -->
        <!-- The sleeve as a play target. Fluent puts its own background and
             border on a hovered button, which would draw a gray box around the
             art, so both are stripped from the content presenter as well. -->
        <Style Selector="Button.coverplay">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.coverplay /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="Button.coverplay:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.coverplay:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <!-- The resting state MUST come from a style, not from Opacity="0" on the
             element. A value set directly in the markup is a LOCAL value, and a
             local value beats every style setter in Avalonia's precedence order —
             so :pointerover set 1, the local 0 won, and the overlay never
             appeared however correct the hover rule looked. -->
        <Style Selector="Button.coverplay Panel#PlayOverlay">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16"
                                      Easing="SineEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.coverplay:pointerover Panel#PlayOverlay">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="Button.coverplay Panel#RevealOverlay">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16"
                                      Easing="SineEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.coverplay:pointerover Panel#RevealOverlay">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="Image.cover">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.22"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- The ground leaves AFTER the cover has faded in over it, not while:
             a cover that fills its tile then looks exactly as it always did, and
             only a small one is ever seen to lose its ground. -->
        <Style Selector="Border.ground">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.22" Delay="0:0:0.22"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.tile">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.tile /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- Window buttons. Two treatments, because the conventions genuinely
             differ: GNOME draws circular controls, Windows draws full-height
             squares that meet the top edge. -->
        <Style Selector="Button.wbtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A2978A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.wbtn.round">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="13"/>
        </Style>
        <!-- The height of the top bar less its rule, so the hover fills the bar
             from edge to edge the way Windows' own caption buttons do. They were
             38 in a bar of 60: "look at the window buttons there is a lot of
             space around them and we really don't need that space." -->
        <Style Selector="Button.wbtn.square">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="43"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.wbtn /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A332B"/>
        </Style>
        <Style Selector="Button.wbtn.square /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.wbtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#554A40"/>
        </Style>
        <Style Selector="Button.wbtn:pointerover">
            <Setter Property="Foreground" Value="#F3EEE6"/>
        </Style>
        <Style Selector="Button.wbtn.close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C42B1C"/>
        </Style>
        <Style Selector="Button.wbtn.close:pointerover">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- A track row is a click target across its whole width, but must not
             look like a button sitting in a list. -->
        <!-- Click to pause or resume. The transport is one line for now; the
             spec's full toolbar comes with the rest of the player. -->
        <Style Selector="Button.nowplaying">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F3EEE6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- Fluent's sliders default to the system blue accent, which is the one
             cold thing in a window whose every other color comes from the
             artwork. Warm neutrals sit correctly on both the chrome bar and an
             album-tinted transport without needing to know which. -->
        <Style Selector="Slider:horizontal /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Background" Value="#E8E0D4"/>
        </Style>
        <Style Selector="Slider:horizontal /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Background" Value="#38FFFFFF"/>
        </Style>
        <Style Selector="Slider /template/ Thumb">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#66000000"/>
        </Style>
        <Style Selector="Slider:pointerover /template/ Thumb">
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <Style Selector="Button.transport">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F3EEE6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.transport.big">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="20"/>
        </Style>
        <!-- Dark overlays, because the transport bar is now a LIGHT color taken
             from the album art. White-on-white would be invisible. -->
        <Style Selector="Button.transport /template/ ContentPresenter">
            <Setter Property="Background" Value="#18000000"/>
        </Style>
        <Style Selector="Button.transport:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#33000000"/>
        </Style>

        <!-- The transport's own slider, dark on light. -->
        <Style Selector="Slider.onlight:horizontal /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Background" Value="#CC000000"/>
        </Style>
        <Style Selector="Slider.onlight:horizontal /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Background" Value="#33000000"/>
        </Style>
        <Style Selector="Slider.onlight /template/ Thumb">
            <Setter Property="Background" Value="#1A1512"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
        </Style>
        <!-- A slow breath on the playing marker. Long and shallow deliberately:
             it should read as "this one is live", not compete with the music. -->
        <Style Selector="Path.pulse">
            <Style.Animations>
                <Animation Duration="0:0:2.2" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.35"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Button.track">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.track /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.track:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1FFFFFFF"/>
        </Style>

        <!-- The playing track wears the hover highlight permanently. A translucent
             white wash rather than a color, so it works against every album
             palette by construction — which a fixed blue did not, and which the
             album's own accent could not, since the disc headers use that. -->
        <Style Selector="Button.track.playing /template/ ContentPresenter">
            <Setter Property="Background" Value="#1FFFFFFF"/>
        </Style>
        <Style Selector="Button.track.playing:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>
        <Style Selector="TextBox.search">
            <Setter Property="Background" Value="#241F1A"/>
            <Setter Property="Foreground" Value="#F3EEE6"/>
            <Setter Property="BorderBrush" Value="#3A332B"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </Window.Styles>

    <!-- The window's real surface. Rounded and clipped here rather than on the
         Window, because the Window's own backing surface is square: a radius set
         on it leaves the old corners showing through. Matches GNOME and Windows
         11, where every other window is rounded. -->
    <Border x:Name="Surface" CornerRadius="12" ClipToBounds="True" Background="#14120F">
    <Panel>
    <DockPanel>

        <!-- 44 tall. It was 60, sized when it also carried the tuning bench, and
             nothing left in it is taller than 27 px. Windows 11 apps that draw
             their own title bar run 40 to 48; the bottom bar here is 50. Anything
             that needs this number reads TopBar.Height, not a copy of it. -->
        <Border x:Name="TopBar" DockPanel.Dock="Top" Background="#1C1915" BorderBrush="#2B2620"
                BorderThickness="0,0,0,1" Height="44">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="8,0,0,0">
                <StackPanel Grid.Column="0" x:Name="LeftButtons" Orientation="Horizontal"
                            Margin="0,0,10,0" Spacing="6" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="AppName" Text="AlbumWall"
                           FontSize="21" FontWeight="Bold"
                           Margin="12,0,0,0" VerticalAlignment="Center"/>
                <!-- The tuning bench used to live here: Light and Tint sliders
                     and a chrome button, added so he could "play with [them] over
                     time". They did their job — the values settled at 21 / 2 /
                     ink — and have moved to the Colors tab in Preferences, where
                     a setting that differs per screen belongs. What is left in
                     the bar is what is used every day. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="20"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="24,0,10,0">


                    <!-- THIS APP'S OWN VOLUME, not the system's.
                         For turning the music down so something else can be
                         heard over it — a notification, a call, someone at the
                         door — without touching anything else that is making
                         noise. Its neighbor on the right is the menu, so it
                         sits at the end of the row where a hand goes looking
                         for a control rather than a setting. -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <Path Data="M 0 5 L 3.5 5 L 8 0.5 L 8 15.5 L 3.5 11 L 0 11 Z
                                    M 11 4.5 A 5.5 5.5 0 0 1 11 11.5"
                              Fill="#F3EEE6" Stroke="#F3EEE6" StrokeThickness="1.4"
                              VerticalAlignment="Center"/>
                        <!-- WHY THE RESOURCES. The Fluent slider is 62 px tall: a 32 px
                             track row with 15 px reserved above and below it for tick
                             marks this one does not have. In a bar of 60 that went
                             unnoticed. In a bar of 44 the control is TALLER THAN THE
                             BAR, and a control that does not fit is not centered at
                             all - it is laid out from the top - so the thumb sat
                             3.3 px under the speaker beside it. "the volume control
                             slider needs to move up a bit though, it's not centered".
                             A margin did nothing, for the same reason. Taking away the
                             reserve makes it 32 px, which fits, which centers - the
                             CONTROL. The thumb is another matter: the template puts
                             its 21 px track row at the TOP of those 32, so the thumb's
                             middle is 4.7 px above the control's (probed: thumb at
                             y 1.3, 20 tall, in a box of 32). The top margin of 9 moves
                             the control down 4.5 and puts the thumb on the speaker's
                             center line, measured from a snapshot to half a pixel. -->
                        <Slider x:Name="VolumeSlider" Width="132" VerticalAlignment="Center"
                                Margin="0,9,0,0"
                                Minimum="0" Maximum="100"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ToolTip.Tip="How loud this app plays">
                            <Slider.Resources>
                                <!-- GridLength, NOT x:Double: the theme uses these as row
                                     heights, and a double here is an InvalidCastException
                                     at startup, before the window exists. -->
                                <GridLength x:Key="SliderPreContentMargin">0</GridLength>
                                <GridLength x:Key="SliderPostContentMargin">0</GridLength>
                            </Slider.Resources>
                        </Slider>
                    </StackPanel>

                    <!-- Settings, straight to Preferences. Placed at the INNER
                         end of the bench rather than a fixed side: the window
                         buttons move between left and right depending on the
                         desktop, and this must not land on top of them.
                         
                         It was a hamburger opening a two-item menu — Preferences
                         and About — and About is a TAB of the window Preferences
                         opens. So the menu's whole job was to ask which way into
                         the same window. His call: "just have a setting button
                         that directly launches it like our other apps." -->
                    <Button x:Name="SettingsButton" Classes="chrome" VerticalAlignment="Center"
                            Padding="8,4" ToolTip.Tip="Preferences">
                        <!-- The dot says a newer version exists. It is the only thing the
                             launch-time check ever does on its own: nothing is downloaded
                             or installed until it is asked for on the About tab. -->
                        <Panel>
                        <Path Stretch="Uniform" Width="17" Height="17" Fill="#F3EEE6"
                              Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58
                                    c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96
                                    c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84
                                    c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33
                                    c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58
                                    C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61
                                    l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54
                                    c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54
                                    c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32
                                    c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z
                                    M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/>
                        <Ellipse x:Name="UpdateDot" Width="7" Height="7" IsVisible="False"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0"
                                 Fill="{DynamicResource WordmarkInk}"/>
                        </Panel>
                    </Button>
                </StackPanel>

                <!-- Filled in code from the window manager's own button-layout
                     preference: which buttons, which side, what order. -->
                <StackPanel Grid.Column="3" x:Name="RightButtons" Orientation="Horizontal"
                            Margin="14,0,8,0" Spacing="6" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- SIZE is the control; column count and library length follow from it. -->
        <!-- 44, to match the top bar: "lets shrink the bottom one to the same
             height as the top". It was 50. The search box is the tallest thing in
             it, at about 30. -->
        <Border x:Name="BottomBar" DockPanel.Dock="Bottom" Background="#1C1915" BorderBrush="#2B2620"
                BorderThickness="0,1,0,0" Height="44">
            <!-- Three columns with equal stars on the outside, so the search box
                 sits at the TRUE center of the window regardless of how long the
                 text either side of it happens to be. -->
            <Panel>
            <!-- Scan progress: a line along the top edge of the bar, where it can
                 be seen without covering anything. It is the ONLY sign of a
                 rescan when the wall is already full, because a rescan must not
                 take the wall away from someone who is using it. Width is set in
                 code as a fraction of the bar. -->
            <Border x:Name="ScanBar" Height="3" Width="0" IsVisible="False"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="{DynamicResource ScanInk}"/>
            <Grid ColumnDefinitions="*,Auto,*" Margin="26,0">
                <!-- No cover-size control. The covers size themselves to fill the
                     window exactly; see MainWindow.ComputeLayout. -->
                <!-- WHICH SIDE IS WHICH was the other way round until 2026-09-20:
                     "let's swap the library stats on the left with the scan
                     results on the right". The status line is the one that
                     changes (a rescan counts up in it), so it goes where a line
                     of text starts; the counts are a fixed fact about the
                     library and sit at the far end.

                     The counts are also A WAY IN: pressing them opens Preferences
                     at the Statistics tab, which is the same three numbers taken
                     apart. A Button (see Button.link) so the keyboard gets there. -->
                <TextBlock Grid.Column="0" x:Name="StatusText" Classes="dim" FontSize="11"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="SearchBox" Classes="search" Width="320"
                         PlaceholderText="Search artist or album…" VerticalAlignment="Center"
                         FontSize="13" Padding="11,5"/>
                <!-- THE LIBRARY PICKER sits in front of the counts, because the
                     counts are about the library it names (decided 2026-09-22:
                     "let's do the bottom-bar library picker"). One library is
                     shown at a time and never merged. The bottom bar stays put
                     when the play controls move to the top, so the picker never
                     moves. The list itself is a menu built when it opens; see
                     MainWindow.OpenLibraryPicker. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="LibraryLink" Classes="link strong" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock x:Name="LibraryText" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Path Data="M 0 0 L 7 0 L 3.5 4 Z" VerticalAlignment="Center"
                                  Fill="{Binding $parent[Button].Foreground}"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="·" Classes="dim" FontSize="11" VerticalAlignment="Center"/>
                    <Button x:Name="CountsLink" Classes="link" VerticalAlignment="Center"
                            ToolTip.Tip="Library statistics">
                        <TextBlock x:Name="CountsText" Classes="mono" FontSize="11"/>
                    </Button>
                </StackPanel>
            </Grid>
            </Panel>
        </Border>

        <!-- Vertical scrolling only: width is fixed by the window.

             The wall is a list of ROWS, not a grid. A uniform grid has no row to
             insert between, and the expansion panel has to push the rows after it
             down. StackLayout still virtualizes, by row instead of by tile. -->
        <!-- FOCUSABLE, which a ScrollViewer is not by default. Esc in an empty search
             box hands the keyboard back to the wall, and until the wall could take
             it the focus simply stayed in the box: the next Esc, meant to fold the
             open album, went to the box again. It is also what lets the arrow keys
             and Page Up / Page Down scroll the wall once the keyboard is there. No
             focus ring - the wall is the whole window and a ring round it is noise. -->
        <ScrollViewer x:Name="WallScroller" Focusable="True" FocusAdorner="{x:Null}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Padding="26,20,26,0">
            <!-- The wall's own layout, not ItemsRepeater. See WallView: the
                 extent here is arithmetic, not an estimate, which is what every
                 scroll bug in this app came out of. -->
            <app:WallView x:Name="Wall" Spacing="15"
                          Rows="{StaticResource AlbumRowTemplate}"
                          PanelTemplate="{StaticResource PanelRowTemplate}"/>
        </ScrollViewer>

    </DockPanel>

    <!-- THE PLAY CONTROLS FLOAT OVER THE WALL. They are not in the DockPanel and
         take no room from it.

         They used to be docked, so showing them made the wall 82 px shorter. That
         was tolerable while they appeared in a single frame, and fell apart the
         moment they were made to slide (80ba5fa): the wall changed size on every
         frame of the slide, every size change re-centers the open album
         (8825766, written for window resizes), and the hold that keeps a panel
         still fought it the whole way - "panel slid 706.7 in all, corrected" for
         one 82 px slide. His diagnosis, exactly: "are we triggering a recenter
         on the current album? that is what it looks like and its blocky and not
         smooth. can we detach the control pane from the album display".

         So: a slot the height of the bar, parked against the inside edge of the
         bottom bar (or the title bar - see ApplyTransportPosition), clipping. The
         bar inside it moves on a render transform from just outside the slot to
         in it, which costs no layout at all. The wall never hears about it. What
         the bar covers stays reachable because the scroller is given that much
         extra padding on that edge while the bar is up (ShowTransport).

         Hidden entirely until something is playing: an empty transport is a row
         of dead controls. -->
    <Border x:Name="TransportSlot" Height="82" ClipToBounds="True" IsVisible="False"
            VerticalAlignment="Bottom" Margin="0,0,0,44">
    <Border x:Name="Transport" Height="82" BorderThickness="0,1,0,0" RenderTransform="translateY(82px)">
        <!-- Title and progress SHARE the slack, weighted 1 : 1.6 in the
             progress bar's favor. A fixed width for either is wrong: a
             230 px title truncates real information, and a title given all
             the slack leaves a progress bar too short to seek in on a wide
             window. Proportions also survive resizing, which fixed widths
             do not. -->
        <Grid ColumnDefinitions="Auto,*,Auto,1.6*,Auto" Margin="26,0">

            <!-- THE WAY BACK TO WHAT IS PLAYING.
                 Nothing else in the app takes you there, and in a wall of a
                 few hundred records you would otherwise go and look for it.
                 The cover of the playing album is the obvious thing to
                 press, for the same reason the panel's sleeve is: it is
                 already a picture of where you want to go.

                 The hover mark is an arrow, not a triangle — pressing this
                 takes you somewhere, it does not start anything. -->
            <Button Grid.Column="0" Classes="coverplay" VerticalAlignment="Center"
                    Click="OnRevealPlaying">
                <Border Width="58" Height="58" CornerRadius="3" ClipToBounds="True">
                    <Panel>
                        <Image x:Name="TransportArt" Stretch="UniformToFill"/>
                        <Panel x:Name="RevealOverlay">
                            <Border Background="#3C000000"/>
                            <Path Data="M 9 5 L 3 11 L 9 17 M 3 11 L 15 11 A 5 5 0 0 1 15 21"
                                  Stroke="#F2FFFFFF" StrokeThickness="2.1"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Panel>
                    </Panel>
                </Border>
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,20,0"
                        MinWidth="230" Spacing="2">
                <!-- The song is what you look down at the bar to read; the
                     artist and album are context and stay quiet. -->
                <TextBlock x:Name="TransportTitle" FontSize="16" FontWeight="Medium"
                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                <TextBlock x:Name="TransportArtist" Classes="dim" FontSize="11"
                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center" Margin="16,0,16,0">
                <Button x:Name="PrevButton" Classes="transport" ToolTip.Tip="Previous"/>
                <Button x:Name="PlayPauseButton" Classes="transport big" ToolTip.Tip="Play / pause"/>
                <Button x:Name="NextButton" Classes="transport" ToolTip.Tip="Next"/>
            </StackPanel>

            <Grid Grid.Column="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                  MinWidth="260" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" x:Name="ElapsedText" Classes="mono dim"
                           FontSize="11" VerticalAlignment="Center" Width="46"
                           TextAlignment="Right"/>
                <Slider Grid.Column="1" x:Name="PositionSlider" Classes="onlight"
                        Minimum="0" Maximum="1"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" x:Name="RemainingText" Classes="mono dim"
                           FontSize="11" VerticalAlignment="Center" Width="52"/>
            </Grid>

            <!-- ReplayGain must be VISIBLE, never silently applied. Click to
                 cycle: album gain keeps a record's own dynamics, track gain
                 levels everything, off is off. -->
            <Button Grid.Column="4" x:Name="GainButton" Classes="chrome"
                    Margin="20,0,0,0" VerticalAlignment="Center"
                    FontSize="10" Padding="10,5"
                    ToolTip.Tip="ReplayGain — click to change"/>
        </Grid>
    </Border>
    </Border>

    <!-- FIRST RUN ON A FRESH MACHINE IS AN EMPTY MUSIC FOLDER, and an empty wall
         with no explanation is indistinguishable from a broken app. This says
         where it looked and offers the one action that fixes it. -->
    <!-- THE FIRST SCAN OF A BIG LIBRARY TAKES MINUTES, and an empty wall that
         says nothing for minutes was, reasonably, reported as a hang. Shown only
         while there is no wall to look at; a rescan over a full wall gets the
         line on the bottom bar instead. -->
    <Border x:Name="ScanState" IsVisible="False" Background="Transparent" IsHitTestVisible="False">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="16" Width="420">
            <TextBlock Text="Reading your library" FontSize="25" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <Border Height="4" CornerRadius="2" Background="{DynamicResource SheetEdge}">
                <Border x:Name="ScanFill" Height="4" CornerRadius="2" Width="0"
                        HorizontalAlignment="Left" Background="{DynamicResource ScanInk}"/>
            </Border>
            <TextBlock x:Name="ScanDetail" Classes="dim mono" FontSize="12"
                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Border>

    <Border x:Name="EmptyState" IsVisible="False" Background="Transparent">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="20" MaxWidth="520">
            <TextBlock Text="No music here yet" FontSize="25" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyWhere" Classes="dim" FontSize="14" LineHeight="21"
                       TextWrapping="Wrap" TextAlignment="Center"/>
            <Button x:Name="EmptyChoose" Classes="panel" Content="Choose your music folder…"
                    HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>


    </Panel>
    </Border>
</Window>
