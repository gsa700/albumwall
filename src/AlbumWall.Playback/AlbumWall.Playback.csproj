<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AlbumWall.Domain\AlbumWall.Domain.csproj" />
    <ProjectReference Include="..\AlbumWall.Codecs\AlbumWall.Codecs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- tools/engine-check.cs, which checks Hymie's insides. -->
    <InternalsVisibleTo Include="engine-check" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Native AOT (docs/roadmap.md, the road to it): warn at every build about
         code a trimmed or compiled build cannot run. -->
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
