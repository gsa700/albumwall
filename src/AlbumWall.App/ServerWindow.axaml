<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:AlbumWall.App"
        x:Class="AlbumWall.App.ServerWindow"
        Title="Add a Navidrome server"
        Icon="/Assets/app.ico"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark"
        Background="{DynamicResource SheetBg}"
        Foreground="#F3EEE6"
        ShowInTaskbar="False">

    <!-- The sign-in itself is ServerSignIn, which the first run's welcome shows
         on its own screen as well. -->
    <app:ServerSignIn x:Name="SignIn" Margin="22,20"/>
</Window>
